{
  "name": "@sibyl/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "~24"
  },
  "scripts": {
    "dev": "next dev --port ${SIBYL_WEB_PORT:-3337}",
    "build": "next build",
    "start": "next start --port ${SIBYL_WEB_PORT:-3337}",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:all": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "generate:types": "openapi-typescript http://localhost:${SIBYL_SERVER_PORT:-3334}/api/openapi.json -o src/lib/api-types.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
