# Sibyl monorepo toolchain versions
# Managed by proto - https://moonrepo.dev/proto
# moon is built-in to proto v0.45+, no plugin needed

proto = "0.61.1"
moon = "2.6.0"
python = "3.13.15"
node = "24.19.0"
pnpm = "12.10.0"
uv = "0.12.5"

[settings]
detect-strategy = "prefer-prototools"
auto-install = true
