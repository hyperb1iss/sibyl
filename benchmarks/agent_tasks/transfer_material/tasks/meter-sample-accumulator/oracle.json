      "input": {
        "readings": [
          {
            "device": "a",
            "label": "x",
            "units": 4
          },
          {
            "device": "a",
            "label": "x",
            "units": -1
          },
          {
            "device": "b",
            "label": "x",
            "units": 7
          }
        ]
      },
      "expected": {
        "totals": {
          "a": 3,
          "b": 7
        }
      }
