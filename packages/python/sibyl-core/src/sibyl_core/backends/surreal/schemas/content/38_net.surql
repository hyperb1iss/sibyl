DEFINE TABLE IF NOT EXISTS net_messages SCHEMAFULL;
ALTER TABLE IF EXISTS net_messages SCHEMAFULL;
ALTER TABLE IF EXISTS net_messages PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS uuid ON net_messages TYPE string;
DEFINE FIELD IF NOT EXISTS organization_id ON net_messages TYPE string;
DEFINE FIELD IF NOT EXISTS channel ON net_messages TYPE string;
DEFINE FIELD IF NOT EXISTS thread ON net_messages TYPE string DEFAULT '';
DEFINE FIELD IF NOT EXISTS kind ON net_messages TYPE string ASSERT $value IN ['message', 'decision'];
DEFINE FIELD IF NOT EXISTS body ON net_messages TYPE string;
DEFINE FIELD IF NOT EXISTS project_id ON net_messages TYPE option<string>;
DEFINE FIELD IF NOT EXISTS author_user_id ON net_messages TYPE string;
DEFINE FIELD IF NOT EXISTS api_key_id ON net_messages TYPE option<string>;
DEFINE FIELD IF NOT EXISTS author_agent ON net_messages TYPE option<string>;
DEFINE FIELD IF NOT EXISTS author_session ON net_messages TYPE option<string>;
DEFINE FIELD IF NOT EXISTS decision_memory_id ON net_messages TYPE option<string>;
DEFINE FIELD IF NOT EXISTS created_at ON net_messages TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS net_message_uuid ON net_messages FIELDS uuid UNIQUE;
DEFINE INDEX IF NOT EXISTS net_message_org_created ON net_messages FIELDS organization_id, created_at, uuid;
DEFINE INDEX IF NOT EXISTS net_message_org_channel_created ON net_messages FIELDS organization_id, channel, created_at;
DEFINE INDEX IF NOT EXISTS net_message_org_channel_thread_created ON net_messages FIELDS organization_id, channel, thread, created_at;
DEFINE TABLE IF NOT EXISTS net_threads SCHEMAFULL;
ALTER TABLE IF EXISTS net_threads SCHEMAFULL;
ALTER TABLE IF EXISTS net_threads PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS organization_id ON net_threads TYPE string;
DEFINE FIELD IF NOT EXISTS channel ON net_threads TYPE string;
DEFINE FIELD IF NOT EXISTS thread ON net_threads TYPE string DEFAULT '';
DEFINE FIELD IF NOT EXISTS project_id ON net_threads TYPE option<string>;
DEFINE FIELD IF NOT EXISTS message_count ON net_threads TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS first_message_at ON net_threads TYPE datetime;
DEFINE FIELD IF NOT EXISTS last_message_at ON net_threads TYPE datetime;
DEFINE FIELD IF NOT EXISTS reflected_through ON net_threads TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS reflection_source_id ON net_threads TYPE option<string>;
DEFINE FIELD IF NOT EXISTS reflection_attempts ON net_threads TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS reflection_error ON net_threads TYPE option<string>;
DEFINE FIELD IF NOT EXISTS reflection_claimed_at ON net_threads TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS updated_at ON net_threads TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS net_thread_key ON net_threads FIELDS organization_id, channel, thread UNIQUE;
DEFINE INDEX IF NOT EXISTS net_thread_idle ON net_threads FIELDS last_message_at;
